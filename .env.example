# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# The loader (coreyard/config.py) does NOT strip trailing comments, so keep comments on their
# own lines — "KEY=value  # note" would make the note part of the value.

# --- Source database (your yard management system's SQL Server) ---
# Reached over the \sql\query SMB named pipe with Windows Auth using the SMB credentials
# below; there is no SQL login and no TCP listener. See README "Database access".
YMS_DB_HOST=
YMS_DB_PORT=1433
# The source database name (from: SELECT name FROM sys.databases)
YMS_DB_NAME=
# Unused — kept only so the config dataclass stays complete. Auth is the SMB account.
YMS_DB_USER=
YMS_DB_PASSWORD=

# --- SMB: image share AND database auth (the yard system's existing service account) ---
# IP or hostname of the database host
SMB_HOST=
# NetBIOS name of that server — required for SMB session setup, not just the IP
SMB_SERVER_NAME=
# The service account and its password
SMB_USER=
SMB_PASSWORD=
# Name of the SMB share holding part photos
SMB_IMAGES_SHARE=
SMB_INVENTORY_SUBDIR=Inventory
SMB_VEHICLE_SUBDIR=Vehicle

# --- Storefront identity (appears in generated titles, descriptions, and tags) ---
# Your yard's business name; written to Shopify's Vendor field on every product
SHOPIFY_VENDOR=
# Location shown in descriptions, e.g. Springfield, IL  (optional — omitted if blank)
STORE_CITY=
# Warranty phrase, e.g. 90-day warranty  (optional — omitted if blank)
STORE_WARRANTY=

# --- Storefront policy (optional; all of these change what is published) -------
# What your listings are allowed to claim: condition wording, the opening line of the
# description, whether "OEM" belongs in a title, part-type wording, audit thresholds.
# CoreYard's built-in defaults state only what the data supports — they do NOT claim that
# every part was tested or inspected, because that is not true at every yard. If it is true
# at yours, say so here. See the profile documentation in coreyard/profile.py.
#
# These strings are published, so changing them changes the rendered product and the next
# sync republishes what they cover.
#STORE_PROFILE_FILE=/path/to/catalog-profile.json

# Estimated packed shipping weights by part type. Without this, products are published with
# no weight and every carrier-calculated rate is quoted for an empty box. The file's shape is
# documented in coreyard/transform/weights.py.
#STORE_WEIGHT_RULES_FILE=/path/to/weights.json

# How each part ships: an ordered classification table with one tag per group. CoreYard
# classifies every part against it and applies the tag during the publish that creates the
# product, so a storefront can warn a shopper before checkout and never has to wait for a
# second pass to make a new product safe to sell. The schema is documented in
# coreyard/transform/shipping.py.
#
# The tag becomes part of the rendered product, so CoreYard then OWNS that namespace: a
# stale tag from whatever wrote them before is replaced rather than left beside the new one.
# Setting this for the first time republishes the catalogue once.
#STORE_SHIPPING_POLICY_FILE=/path/to/freight.json

# Optional reviewed per-R# title decisions. These feed the canonical renderer and its
# fingerprint. Prices always come directly from the source database.
#STORE_CATALOG_OVERRIDES_FILE=/path/to/catalog-overrides.json

# The optional listing-portal channel (`coreyard ebay`). CoreYard speaks no portal's
# protocol natively: routes, field names, statuses and action ids all come from this map,
# the way source table names come from schema.json. Copy portal.example.json, fill it in,
# and keep it out of git — those identifiers belong to the portal's vendor, not here.
#EBAY_PORTAL_FILE=/path/to/portal.json

# Portal authentication, in the order it is tried. An explicit cookie header wins; failing
# that a local Firefox profile is read read-only, and a working jar is cached owner-only so
# a live session survives closing the browser tab. Never put a cookie header in a shell
# history or a command line.
#EBAY_PORTAL_COOKIES=session=...; account=...
#EBAY_PORTAL_COOKIE_FILE=/path/to/portal.cookies
#EBAY_PORTAL_FIREFOX_DIR=/home/you/.mozilla/firefox
# Sign-in of last resort, for unattended runs that outlive a borrowed browser session.
# Used only when the cookie sources above yield nothing, and only if portal.json maps
# "auth.login_fields". The client also re-signs in once when a run hits an expired session
# mid-pass, which a long portal maintenance run could otherwise lose entirely.
#EBAY_PORTAL_USER=you@example.com
#EBAY_PORTAL_PASSWORD=...

# eBay's own item-aspect metadata for the category being listed, fetched from eBay and
# saved as {"aspects": {...}}. Derivation runs without it, but `ebay aspects --apply`
# refuses to write unvalidated item specifics: a wrong aspect ranks worse than a missing
# one, because buyers filter on the value.
#EBAY_ASPECTS_FILE=out/ebay-item-aspects.json

# A free developer keyset from developer.ebay.com, used only by
# scripts/fetch_ebay_aspects.py to build the file above from eBay's Taxonomy API. It is
# unrelated to the listing portal and to any partner arrangement, and nothing in the
# publishing path reads it.
#EBAY_APP_ID=...
#EBAY_CERT_ID=...

# The Warranty item specific to send when the portal supplies none. Like every other
# claim, it is the seller's to make, so there is no built-in default.
#EBAY_DEFAULT_WARRANTY=30 Day

# Only publish parts that have at least one photo. Off by default so an upgrade never
# silently changes which parts an existing installation lists. Turning it on requires an
# "images_filter" expression in schema.json, and it applies everywhere at once: sync,
# reconciliation, bulk publishing, and the audit.
STORE_REQUIRE_IMAGES=false

# How many of a donor vehicle's photographs a part may inherit when it has none of its own.
# Requires a "donor_images" mapping in schema.json; without one, nothing falls back. A donor
# shoot documents a whole car (commonly 16 frames, sometimes 99), so the opening frames --
# the general views -- are taken and the rest left. Each frame is uploaded to the storefront
# once and referenced by every part off that donor, not re-uploaded per part.
#STORE_DONOR_PHOTO_LIMIT=6

# Sales channels a published product should appear on, comma-separated. A product's status
# and its channel publication are different things, and only the second makes its URL
# resolve — an ACTIVE product on no channel is a 404 to shoppers and to Google. Empty means
# CoreYard leaves publication alone.
#STORE_PUBLICATIONS=Online Store

# Tag prefixes owned by another system, comma-separated. Namespaced tags (anything with a
# ":") are preserved automatically, because CoreYard generates none of its own — except in a
# namespace it has taken over, such as the shipping policy's, where a stale tag is replaced.
# Name a prefix here only for a system that writes plain tags.
#STORE_PRESERVED_TAG_PREFIXES=

# Check every file above against its schema, without a database, a store, or credentials:
#   bin/coreyard validate

# Product handles are <prefix>-<R#>. This is the storefront's primary key: pick it ONCE
# before your first publish and never change it. Changing it on a live store makes every
# product look new and duplicates the entire catalog. Defaults to "coreyard".
SHOPIFY_HANDLE_PREFIX=coreyard

# Storefront policy as one file: sections profile / weights / shipping / orders.
# Copy store.example.json to store.json and CoreYard finds it; set this only to put it
# somewhere else. A path named here must exist. The individual STORE_*_FILE settings
# below still work and still take precedence over a section of the same name.
#STORE_FILE=store.json

# --- Shopify ---
# your-store.myshopify.com
SHOPIFY_STORE=
# Defaults to the API version the repository is tested against.
#SHOPIFY_API_VERSION=2026-07

# Path A — direct token from an in-admin "Develop apps" custom app:
# SHOPIFY_ADMIN_TOKEN=shpat_xxx

# Path B — dev-dashboard app (Client ID + Secret). Run `python -m coreyard.sink.shopify_oauth`
# to exchange these for SHOPIFY_ADMIN_TOKEN. First add this redirect URL to the app:
#   http://localhost:3456/callback
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Defaults include product, inventory, file, location, and paid-order webhook access.
# SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_files,write_files,read_orders
# SHOPIFY_OAUTH_REDIRECT=http://localhost:3456/callback

# --- Order webhook (optional) -------------------------------------------------
# Webhooks created through the Admin API are signed with the app's client secret,
# so SHOPIFY_CLIENT_SECRET above is normally enough. Set this only for a webhook
# created by hand in the Shopify admin, which gets its own signing key.
#SHOPIFY_WEBHOOK_SECRET=
# Successful payloads are erased immediately. Failed payloads remain retryable for this
# many days. The receiver sweeps on startup and hourly while it remains online.
COREYARD_WEBHOOK_ERROR_RETENTION_DAYS=7

# --- Booking sales back into the yard system (optional) -----------------------
# When set, the paid-order webhook also creates a work order in the source database for
# each sale. This is the ONLY write CoreYard makes to that database, it is off by
# default, and it additionally requires an "order_write" section in schema.json —
# the table and column names are yours, not this project's.
#
# Read schema.example.json's order_write notes before turning this on. In
# particular decide the tax stance deliberately: if your storefront already
# collects and remits sales tax, line_items_taxable must be false there or the
# same sale is taxed twice.
#YMS_WRITE_ORDERS=1
# Order status sync (`bin/coreyard orders sync-status`): what to tag and note on an order
# the source system has invoiced. If a shipping policy is configured, the fulfillment rules
# are derived from it — which groups exist and who ships them is already declared there, and
# a second copy is free to drift. Without either, the command only tags and notes. See
# coreyard/orders/policy.py.
#STORE_ORDER_POLICY_FILE=/path/to/order-sync.json

# Add part-type synonyms and decoded donor-vehicle detail (engine, transmission, trim) to
# listings. Needs 'part_type_aliases'/'vehicle_details' in schema.json.
#
# This changes the rendered product, and the rendered product is what the sync fingerprints,
# so turning it on makes the NEXT RUN REPUBLISH EVERY PRODUCT IT COVERS — thousands of Admin
# API calls. That is a rollout to schedule deliberately (ideally overnight, and worth a
# `--dry-run` first to see the count), not a switch to flip casually.
COREYARD_ENRICH=false

# Where a health alert goes, beyond the system journal.
#
# `scripts/healthcheck.py` always writes to the journal (`journalctl -t coreyard-health`),
# which needs no session and is what an investigation reads afterwards. It deliberately has
# no built-in desktop popup: how an operator wants to be interrupted is not this tool's
# decision, and one command covers every answer. The subject and body arrive as
# COREYARD_ALERT_SUBJECT and COREYARD_ALERT_BODY.
#
#   COREYARD_ALERT_CMD='notify-send "$COREYARD_ALERT_SUBJECT" "$COREYARD_ALERT_BODY"'
#   COREYARD_ALERT_CMD='curl -sf -X POST -d "$COREYARD_ALERT_BODY" https://hooks.example/…'
#   COREYARD_ALERT_CMD='mail -s "$COREYARD_ALERT_SUBJECT" you@example.com <<< "$COREYARD_ALERT_BODY"'
#
# Unset means journal only.
#COREYARD_ALERT_CMD=

# Where inventory comes from. Unset means the source database described by schema.json,
# which is what every existing installation uses.
# A yard on another system can export a CSV whose columns are named after Part fields:
#COREYARD_SOURCE=tabular:/path/to/parts.csv
# Photographs for a tabular source, named "<R#>_*" as on the share.
#COREYARD_SOURCE_IMAGES=/path/to/photos
