# Secrets — never commit
.env
*.auth

# Local agent/editor state (kept out of the repo, not just out of one machine's
# global ignore file, so the rule travels with a clone)
.claude/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated output (images, CSVs, schema dumps, state db)
out/images/
out/schema/
out/*.csv
*.sqlite3

# All generated output
/out/

# Generated by install.sh
/bin/

# Site-specific source-schema mapping — never commit
schema.json
