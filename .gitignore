# Secrets — never commit
.env
*.auth

# Local agent/editor state (kept out of the repo, not just out of one machine's
# global ignore file, so the rule travels with a clone)
.claude/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated output (images, CSVs, schema dumps, state db)
out/images/
out/schema/
out/*.csv
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# All generated output
/out/

# Generated by install.sh
/bin/

# Site-specific source-schema mapping — never commit
schema.json

# Leftover from the listing-portal channel, removed 2026-09-08 when the supported product
# became source database -> Shopify -> sales. The file still exists on installations that
# ran it, and its endpoints and field ids belong to that vendor, so the rule stays whether
# or not anything reads the file.
portal.json

# Portal session cookies
*.cookies

# Reverse-engineered portal protocol notes and the vendor's own reference data.
# Same rule as portal.json: useful next to the code, never in the tree.
notes/

# Browser network captures: these carry live session cookies.
*.har

# Operational tracking for one installation: live catalogue counts, asking values and
# portal listing ids. Same rule as notes/ — useful
# beside the code, never in the tree. This repository is public and none of it
# is generic.
/CHECKLIST.TXT
/ROADMAP.md
