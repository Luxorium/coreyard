      "search": "search",
      "timestamp": "timestamp",
      "part_type": "part_type",
      "quick_search": "quick_search"
    },
    "detail": {
      "listing_id": "listing_id",
      "status": "status"
    },
    "bulk_update": {
      "changes": "changes",
      "update_all": "update_all",
