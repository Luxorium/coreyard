      "listing_ids": "listing_ids",
      "status": "status",
      "session": "session",
      "list_as_new": "list_as_new",
      "clear_errors": "clear_errors"
    },
    "end": {
      "update_all": "update_all",
      "listing_ids": "listing_ids",
      "status": "status",
      "session": "session"
    }
